{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/router.js": {
      "includeFiles": "lib/data/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:action(status|places|routes)", "destination": "/api/router?action=:action" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
